# Bot Service Environment Variables
# Copy this file and fill in your actual values when deploying Telegram and WhatsApp bots

# ============================================================
# REQUIRED: API Base URL
# ============================================================
# Where your Mozosubz backend is hosted (production or staging)
NEXT_PUBLIC_API_URL=https://your-domain.com
API_BASE_URL=https://your-domain.com

# ============================================================
# REQUIRED: Bot Authentication
# ============================================================
# These are FIXED and never change - they're part of your deployed backend
# Do NOT modify these values
BOT_AUTH_REQUEST_OTP_ENDPOINT=/api/v1/bot-auth/request-otp
BOT_AUTH_VERIFY_OTP_ENDPOINT=/api/v1/bot-auth/verify-otp
BOT_AUTH_VALIDATE_KEY_ENDPOINT=/api/v1/bot-auth/validate-key
BOT_AUTH_DISCONNECT_ENDPOINT=/api/v1/bot-auth/disconnect
BOT_AUTH_CONNECTIONS_ENDPOINT=/api/v1/bot-auth/connections

# ============================================================
# REQUIRED: Wallet Endpoints
# ============================================================
# These are FIXED and never change - they're part of your deployed backend
WALLET_BALANCE_ENDPOINT=/api/v1/wallet/balance
WALLET_TRANSACTIONS_ENDPOINT=/api/v1/wallet/transactions
WALLET_DEPOSIT_ENDPOINT=/api/v1/wallet/deposit

# ============================================================
# REQUIRED: Data & Airtime Purchase Endpoints
# ============================================================
# These are FIXED and never change - they're part of your deployed backend
DATA_PLANS_ENDPOINT=/api/v1/data/plans
DATA_PURCHASE_ENDPOINT=/api/v1/data/purchase
AIRTIME_PURCHASE_ENDPOINT=/api/v1/airtime/purchase

# ============================================================
# TELEGRAM BOT ONLY
# ============================================================
# Get from Telegram BotFather: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Telegram bot username (without @)
TELEGRAM_BOT_USERNAME=mozosubz_bot
# Optional: Webhook URL if using webhooks instead of polling
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook/telegram

# ============================================================
# WHATSAPP BOT ONLY
# ============================================================
# Meta/WhatsApp Business API credentials
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
# Webhook verify token (create a random string)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=random_verify_token_you_create
# Optional: Business phone number for display
WHATSAPP_BUSINESS_PHONE=+234800000000

# ============================================================
# BOT BEHAVIOR & MESSAGING
# ============================================================
# Default language (en, fr, etc)
BOT_DEFAULT_LANGUAGE=en
# Enable debug logging (true/false)
BOT_DEBUG_MODE=false
# Request timeout in milliseconds
BOT_REQUEST_TIMEOUT=30000
# Max retry attempts for API calls
BOT_MAX_RETRIES=3

# ============================================================
# RATE LIMITING (Per user, per minute)
# ============================================================
# Max OTP requests per user per hour (prevent spam)
BOT_OTP_RATE_LIMIT_PER_HOUR=5
# Max API calls per user per minute (already enforced: 50/min)
BOT_API_RATE_LIMIT_PER_MINUTE=50

# ============================================================
# SESSION & CACHING (if using Redis)
# ============================================================
# Optional: Redis connection string for session management
REDIS_URL=redis://localhost:6379
# Session TTL in seconds (default: 1 hour)
SESSION_TTL=3600
# OTP cache TTL in seconds (should match OTP expiry: 5 minutes)
OTP_CACHE_TTL=300

# ============================================================
# LOGGING & MONITORING
# ============================================================
# Where to send error logs (Sentry, LogRocket, etc)
ERROR_TRACKING_URL=https://your-error-tracking-service.com
# Your error tracking DSN/key if using Sentry, etc
SENTRY_DSN=your_sentry_dsn_here

# ============================================================
# OPTIONAL: Feature Flags
# ============================================================
# Enable/disable specific features
FEATURE_AIRTIME_PURCHASE=true
FEATURE_DATA_PURCHASE=true
FEATURE_CABLE_TV=false
FEATURE_ELECTRICITY=false
FEATURE_WALLET_DEPOSIT=true
FEATURE_TRANSACTION_HISTORY=true

# ============================================================
# OPTIONAL: Bot Names & Branding
# ============================================================
BOT_NAME_TELEGRAM=Mozosubz Bot
BOT_NAME_WHATSAPP=Mozosubz
BOT_COMPANY_NAME=Mozosubz
BOT_SUPPORT_EMAIL=support@mozosubz.com
BOT_WEBSITE=https://mozosubz.com
